#include "prayer.h"
#include "PrayerTimes.h" // المكتبة الخاصة بحساب مواقيت الصلاة
#include "dfplayer.h"    // للتحكم في مشغل الصوت
#include "display.h"     // لتحديث الشاشة

// --- إعدادات الوقت والموقع (مهم جداً: قم بتعديلها لتناسب موقعك) ---
const char* ntpServer = "pool.ntp.org";
const long gmtOffset_sec = 3 * 3600; // مثال: UTC+3 (3 ساعات * 3600 ثانية)
const int daylightOffset_sec = 0;    // التوقيت الصيفي (إذا كان مطبقاً)

// إحداثيات موقعك (مثال: الرياض)
double latitude = 24.7136;
double longitude = 46.6753;

// --------------------------------------------------------------------

double prayerTimes[sizeof(TimeName) / sizeof(char*)];
int prayerTimeMinutes[sizeof(TimeName) / sizeof(char*)];
const char* prayerNames[] = {"Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"};

int nextPrayerIndex = -1;
bool azanPlayed[sizeof(TimeName) / sizeof(char*)] = {false};

void prayer_init() {
    // ضبط الوقت من سيرفر NTP
    configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
    Serial.println("Time configured via NTP");

    // ضبط طريقة حساب مواقيت الصلاة (مثال: جامعة أم القرى، مكة)
    // طرق أخرى: Jafari, Karachi, ISNA, MWL, Egypt, Custom
    setCalcMethod(MWL); // Muslim World League
    setAsrMethod(Shafii); // يمكنك تغييرها إلى Hanafi
    setHighLatsMethod(AngleBased);
    setFajrAngle(18);
    setIshaAngle(17);
}

void calculate_prayer_times() {
    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
        Serial.println("Failed to obtain time");
        return;
    }

    // حساب أوقات الصلاة لليوم الحالي
    getPrayerTimes(timeinfo.tm_year + 1900, timeinfo.tm_mon + 1, timeinfo.tm_mday, latitude, longitude, (gmtOffset_sec / 3600.0), prayerTimes);

    // تحويل أوقات الصلاة إلى دقائق من بداية اليوم
    for (int i = 0; i < sizeof(prayerTimes) / sizeof(double); i++) {
        int hours, minutes;
        getHourMinute(prayerTimes[i], hours, minutes);
        prayerTimeMinutes[i] = hours * 60 + minutes;
    }
}

void prayer_loop() {
    static unsigned long lastCheck = 0;
    unsigned long now = millis();

    // يتم التحديث كل دقيقة
    if (now - lastCheck < 60000 && lastCheck != 0) {
        return;
    }
    lastCheck = now;

    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
        return;
    }

    // إعادة حساب أوقات الصلاة بعد منتصف الليل
    if (timeinfo.tm_hour == 0 && timeinfo.tm_min == 0) {
        calculate_prayer_times();
        for(int i=0; i<6; i++) azanPlayed[i] = false; // إعادة ضبط مؤشر الأذان
    }

    int currentMinute = timeinfo.tm_hour * 60 + timeinfo.tm_min;

    // البحث عن الصلاة التالية
    nextPrayerIndex = -1;
    for (int i = 0; i < 6; i++) {
        if (prayerTimeMinutes[i] > currentMinute) {
            nextPrayerIndex = i;
            break;
        }
    }
    // إذا كانت كل صلوات اليوم قد فاتت، فالصلاة التالية هي الفجر
    if (nextPrayerIndex == -1) {
        nextPrayerIndex = 0; 
    }

    // التحقق مما إذا كان وقت الأذان قد حان
    for (int i = 0; i < 6; i++) {
        // لا يوجد أذان للشروق
        if (i == Sunrise) continue;

        if (prayerTimeMinutes[i] == currentMinute && !azanPlayed[i]) {
            Serial.print("Azan for ");
            Serial.println(prayerNames[i]);
            
            // تشغيل ملف الأذان (مثال: مجلد 1، ملف 1)
            playAzan(1, i + 1); 
            azanPlayed[i] = true;
        }
    }
}

String get_next_prayer_name() {
    if (nextPrayerIndex != -1) {
        return prayerNames[nextPrayerIndex];
    }
    return "---";
}