            <button
                class="btn-secondary"
                onclick="location.href='index.html'">

                رجوع

            </button>

        </div>

    </footer>

    <script>

        /* =========================================================
        Constants
        ========================================================= */

        const IQAMA_FOLDER = 2;

        const IQAMA_FILE = 4;


        /* =========================================================
        Presets
        ========================================================= */

        function splitPreset(value) {

            const parts = String(value).split(":");

            return {

                folder: Number(parts[0]) || 0,

                file: Number(parts[1]) || 0

            };

        }


        function setPresetFromValues(type, folder, file) {

            const preset =
                document.getElementById(
                    type + "Preset"
                );

            if (!preset) return;


            const value =
                Number(folder) +
                ":" +
                Number(file);


            for (const option of preset.options) {

                if (option.value === value) {

                    preset.value = value;

                    return;

                }

            }

        }

        function readPresetValues(type) {
            const preset = document.getElementById(type + "Preset");
            if (!preset) {
                return { folder: 1, file: 1 };
            }

            const parts = String(preset.value).split(":");
            return {
                folder: Number(parts[0]) || 1,
                file: Number(parts[1]) || 1
            };
        }


        function applyPreset(type) {

            const preset =
                document.getElementById(
                    type + "Preset"
                );

            if (!preset) return;


            const selected =
                splitPreset(preset.value);


            setNumber(
                type + "Folder",
                selected.folder
            );


            setNumber(
                type + "File",
                selected.file
            );

        }


        function applyIqamaPreset() {

            const preset =
                document.getElementById(
                    "iqamaPreset"
                );

            if (!preset) return;


            const selected =
                splitPreset(preset.value);


            console.log(
                "Iqama preset:",
                selected.folder,
                selected.file
            );

        }


        /* =========================================================
        Volume Helpers
        ========================================================= */

        function showVolume(value) {

            const element =
                document.getElementById(
                    "volumeValue"
                );

            if (element) {

                element.textContent = value;

            }

        }


        function showValue(id, value) {

            const element =
                document.getElementById(id);

            if (element) {

                element.textContent = value;

            }

        }


        function setNumber(id, value) {

            const element =
                document.getElementById(id);

            if (element) {

                element.value =
                    value ?? "";

            }

        }


        function setSelect(id, value) {

            const element =
                document.getElementById(id);

            if (element) {

                if (value === true || value === false) {

                    element.value =
                        value ? "true" : "false";

                } else if (typeof value === "string") {

                    element.value =
                        value;

                } else {

                    element.value =
                        String(value);

                }

            }

        }


/* =========================================================
   Quran Settings
   ========================================================= */

let quranSettings = {

    baqarah: {
        enable: true,
        hour: 0,
        minute: 0,
        volume: 25,
        folder: 1,
        file: 1
    },

    baqarahLast: {
        enable: true,
        hour: 0,
        minute: 0,
        volume: 25,
        folder: 1,
        file: 2
    },

    ayatKursi: {
        enable: true,
        hour: 0,
        minute: 0,
        volume: 25,
        folder: 1,
        file: 3
    },

    maryam: {
        enable: true,
        hour: 0,
        minute: 0,
        volume: 25,
        folder: 1,
        file: 4
    }

};


/* =========================================================
   Get Selected Quran
   ========================================================= */

function getSelectedQuran() {

    const element =
        document.getElementById("quranType");

    return element
        ? element.value
        : "baqarah";

}


/* =========================================================
   Get Folder / File From Selected Quran
   ========================================================= */

function getSelectedQuranFile() {

    const select =
        document.getElementById("quranType");


    if (!select) {

        return null;

    }


    const option =
        select.options[
            select.selectedIndex
        ];


    if (!option) {

        return null;

    }


    const folder =
        Number(
            option.dataset.folder
        );


    const file =
        Number(
            option.dataset.file
        );


    if (
        !Number.isFinite(folder) ||
        !Number.isFinite(file) ||
        folder < 1 ||
        file < 1
    ) {

        console.error(
            "[QURAN] Invalid folder/file",
            {
                type: option.value,
                folder: folder,
                file: file
            }
        );

        return null;

    }


    return {

        type:
            option.value,

        folder:
            folder,

        file:
            file

    };

}


/* =========================================================
   Load Selected Quran
   ========================================================= */

function loadSelectedQuran() {

    const selected =
        getSelectedQuranFile();


    if (!selected) {

        return;

    }


    const type =
        selected.type;


    const data =
        quranSettings[type];


    if (!data) {

        console.error(
            "[QURAN] Settings not found:",
            type
        );

        return;

    }


    /*
     * Folder and file are fixed in HTML.
     * Only the user's settings are loaded here.
     */

    setSelect(
        "quranEnable",
        data.enable
    );


    setNumber(
        "quranHour",
        data.hour
    );


    setNumber(
        "quranMinute",
        data.minute
    );


    setNumber(
        "quranVolume",
        data.volume
    );


    showValue(
        "quranVolumeValue",
        data.volume
    );


    console.log(
        "[QURAN] Selected:",
        type,
        "Folder:",
        selected.folder,
        "File:",
        selected.file
    );

}

/* =========================================================
   Read Current Quran
   ========================================================= */

function readCurrentQuran() {

    const selected =
        getSelectedQuranFile();

    if (!selected) {
        return;
    }

    const type =
        selected.type;


    quranSettings[type] = {

        enable:
            document.getElementById(
                "quranEnable"
            ).value === "true",


        hour:
            Number(
                document.getElementById(
                    "quranHour"
                ).value
            ) || 0,


        minute:
            Number(
                document.getElementById(
                    "quranMinute"
                ).value
            ) || 0,


        volume:
            Number(
                document.getElementById(
                    "quranVolume"
                ).value
            ) || 0,


        /*
         * IMPORTANT:
         * Folder/File come from the selected
         * HTML option.
         */

        folder:
            selected.folder,

        file:
            selected.file

    };


    console.log(
        "[QURAN] Saved current selection:",
        quranSettings[type]
    );

}
        /* =========================================================
        Load Audio Settings
        ========================================================= */

        function loadAudioSettings() {

            fetch("/api/settings/audio")

                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "HTTP " +
                            response.status
                        );

                    }

                    return response.json();

                })


                .then(data => {

                    /* General */

                    setNumber(
                        "volume",
                        data.volume
                    );

                    showVolume(
                        data.volume
                    );


                    /* Azan */

                    setSelect(
                        "azanEnable",
                        data.azanEnable
                    );


                    setNumber(
                        "azanFolder",
                        data.azanFolder
                    );


                    setNumber(
                        "azanFile",
                        data.azanFile
                    );


                    setPresetFromValues(
                        "azan",
                        data.azanFolder,
                        data.azanFile
                    );


                    /* Iqama */

                    setSelect(
                        "iqamaEnable",
                        data.iqamaEnable
                    );


                    setNumber(
                        "iqamaVolume",
                        data.iqamaVolume ?? 20
                    );


                    showValue(
                        "iqamaVolumeValue",
                        data.iqamaVolume ?? 20
                    );


                    setNumber(
                        "iqamaDelay",
                        data.iqamaDelay
                    );


                    document.getElementById(
                        "iqamaFajr"
                    ).checked =
                        data.iqamaFajr === true;


                    document.getElementById(
                        "iqamaDhuhr"
                    ).checked =
                        data.iqamaDhuhr === true;


                    document.getElementById(
                        "iqamaAsr"
                    ).checked =
                        data.iqamaAsr === true;


                    document.getElementById(
                        "iqamaMaghrib"
                    ).checked =
                        data.iqamaMaghrib === true;


                    document.getElementById(
                        "iqamaIsha"
                    ).checked =
                        data.iqamaIsha === true;


                    /* Morning Adhkar */

                    setSelect(
                        "morningAdhkarEnable",
                        data.morningAdhkarEnable
                    );


                    setNumber(
                        "morningAdhkarHour",
                        data.morningAdhkarHour
                    );


                    setNumber(
                        "morningAdhkarMinute",
                        data.morningAdhkarMinute
                    );


                    setNumber(
                        "morningAdhkarVolume",
                        data.morningAdhkarVolume
                    );


                    setNumber(
                        "morningAdhkarFolder",
                        data.morningAdhkarFolder
                    );


                    setNumber(
                        "morningAdhkarFile",
                        data.morningAdhkarFile
                    );


                    showValue(
                        "morningAdhkarVolumeValue",
                        data.morningAdhkarVolume
                    );


                    /* Evening Adhkar */

                    setSelect(
                        "eveningAdhkarEnable",
                        data.eveningAdhkarEnable
                    );


                    setNumber(
                        "eveningAdhkarHour",
                        data.eveningAdhkarHour
                    );


                    setNumber(
                        "eveningAdhkarMinute",
                        data.eveningAdhkarMinute
                    );


                    setNumber(
                        "eveningAdhkarVolume",
                        data.eveningAdhkarVolume
                    );


                    setNumber(
                        "eveningAdhkarFolder",
                        data.eveningAdhkarFolder
                    );


                    setNumber(
                        "eveningAdhkarFile",
                        data.eveningAdhkarFile
                    );


                    showValue(
                        "eveningAdhkarVolumeValue",
                        data.eveningAdhkarVolume
                    );


                    /* Kahf */

                    setSelect(
                        "kahfEnable",
                        data.kahfEnable
                    );


                    setNumber(
                        "kahfHour",
                        data.kahfHour
                    );


                    setNumber(
                        "kahfMinute",
                        data.kahfMinute
                    );


                    setNumber(
                        "kahfVolume",
                        data.kahfVolume
                    );


                    setNumber(
                        "kahfFolder",
                        data.kahfFolder
                    );


                    setNumber(
                        "kahfFile",
                        data.kahfFile
                    );


                    showValue(
                        "kahfVolumeValue",
                        data.kahfVolume
                    );


                    /* Quran */

                    if (data.quran) {

                        Object.keys(
                            quranSettings
                        ).forEach(type => {

                            if (
                                data.quran[type]
                            ) {

                                quranSettings[type] =
                                    data.quran[type];

                            }

                        });

                    }


                    loadSelectedQuran();


                    document.getElementById(
                        "status"
                    ).textContent =
                        "متصل";

                })


                .catch(error => {

                    console.error(
                        "Audio settings error:",
                        error
                    );


                    document.getElementById(
                        "status"
                    ).textContent =
                        "خطأ اتصال";

                });

        }


        /* =========================================================
        Test Helpers
        ========================================================= */

        function testEndpoint(
            endpoint,
            successMessage
        ) {

            fetch(
                endpoint,
                {
                    method: "POST"
                }
            )

            .then(response => {

                console.log("Save response status:", response.status);

                if (!response.ok) {

                    throw new Error(
                        "HTTP " +
                        response.status
                    );

                }

                return response.text();

            })

            .then(text => {

                console.log("Save response body:", text);

                alert(
                    successMessage
                );

            })

            .catch(error => {

                console.error(
                    error
                );

                alert(
                    "فشل التشغيل"
                );

            });

        }


        function testAzan() {

            testEndpoint(
                "/api/test/azan",
                "تم تشغيل الأذان"
            );

        }


        function testIqama() {

            testEndpoint(
                "/api/test/iqama",
                "تم تشغيل الإقامة"
            );

        }


        function testMorningAdhkar() {

            testEndpoint(
                "/api/test/morning-adhkar",
                "تم تشغيل أذكار الصباح"
            );

        }


        function testEveningAdhkar() {

            testEndpoint(
                "/api/test/evening-adhkar",
                "تم تشغيل أذكار المساء"
            );

        }


        function testKahf() {

            testEndpoint(
                "/api/test/kahf",
                "تم تشغيل سورة الكهف"
            );

        }


/* =========================================================
   Test Quran
   ========================================================= */

function testQuran() {

    const selected =
        getSelectedQuranFile();


    if (!selected) {

        alert(
            "لم يتم اختيار محتوى القرآن"
        );

        return;

    }


    const volume =
        Number(
            document.getElementById(
                "quranVolume"
            ).value
        ) || 25;


    console.log(
        "[QURAN TEST]",
        {
            type: selected.type,
            folder: selected.folder,
            file: selected.file,
            volume: volume
        }
    );


    fetch(
        "/api/test/quran",
        {

            method: "POST",

            headers: {

                "Content-Type":
                    "application/json"

            },

            body:
                JSON.stringify({

                    type:
                        selected.type,

                    folder:
                        selected.folder,

                    file:
                        selected.file,

                    volume:
                        volume

                })

        }
    )


    .then(response => {

        if (!response.ok) {

            throw new Error(
                "HTTP " +
                response.status
            );

        }


        return response.text();

    })


    .then(text => {

        console.log(
            "[QURAN TEST] Response:",
            text
        );


        alert(
            "تم تشغيل المحتوى المختار"
        );

    })


    .catch(error => {

        console.error(
            "[QURAN TEST]",
            error
        );


        alert(
            "فشل تشغيل المحتوى المختار"
        );

    });

}

        /* =========================================================
        Play Folder
        ========================================================= */

        function playFolder() {

            const folder =
                Number(
                    document.getElementById(
                        "folder"
                    ).value
                );


            const volume =
                Number(
                    document.getElementById(
                        "folderVolume"
                    ).value
                );


            fetch(
                "/api/test/folder",
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        folder: folder,

                        volume: volume

                    })

                }
            )


            .then(response => {

                if (!response.ok) {

                    throw new Error(
                        "فشل تشغيل المجلد"
                    );

                }

                return response.text();

            })


            .then(() => {

                alert(
                    "تم تشغيل المجلد"
                );

            })


            .catch(error => {

                console.error(
                    error
                );

                alert(
                    "فشل تشغيل المجلد"
                );

            });

        }


        /* =========================================================
        Save Audio Settings
        ========================================================= */

        function saveAudioSettings() {

            console.log("saveAudioSettings() called");

            function readBool(id) {
                const element = document.getElementById(id);
                if (!element) return false;
                const value = element.value;
                if (value === true || value === false) return value;
                if (value === "true") return true;
                if (value === "false") return false;
                return value === "1";
            }

            function readNumber(id, fallback = 0) {
                const element = document.getElementById(id);
                if (!element) return fallback;
                const parsed = Number(element.value);
                return Number.isFinite(parsed) ? parsed : fallback;
            }

            const azanPreset = readPresetValues("azan");
            const iqamaPreset = readPresetValues("iqama");

            const data = {
                volume: readNumber("volume", 15),
                azanEnable: readBool("azanEnable"),
                azanFolder: azanPreset.folder,
                azanFile: azanPreset.file,
                iqamaEnable: readBool("iqamaEnable"),
                iqamaFolder: iqamaPreset.folder,
                iqamaFile: iqamaPreset.file,
                iqamaVolume: readNumber("iqamaVolume", 12),
                iqamaDelay: readNumber("iqamaDelay", 10),
                iqamaFajr: document.getElementById("iqamaFajr").checked,
                iqamaDhuhr: document.getElementById("iqamaDhuhr").checked,
                iqamaAsr: document.getElementById("iqamaAsr").checked,
                iqamaMaghrib: document.getElementById("iqamaMaghrib").checked,
                iqamaIsha: document.getElementById("iqamaIsha").checked,
                morningAdhkarEnable: readBool("morningAdhkarEnable"),
                morningAdhkarHour: readNumber("morningAdhkarHour", 6),
                morningAdhkarMinute: readNumber("morningAdhkarMinute", 0),
                morningAdhkarVolume: readNumber("morningAdhkarVolume", 9),
                eveningAdhkarEnable: readBool("eveningAdhkarEnable"),
                eveningAdhkarHour: readNumber("eveningAdhkarHour", 18),
                eveningAdhkarMinute: readNumber("eveningAdhkarMinute", 0),
                eveningAdhkarVolume: readNumber("eveningAdhkarVolume", 9),
                kahfEnable: readBool("kahfEnable"),
                kahfHour: readNumber("kahfHour", 0),
                kahfMinute: readNumber("kahfMinute", 0),
                kahfVolume: readNumber("kahfVolume", 10),
                quran: quranSettings
            };

            console.log("Sending audio settings payload", data);

            fetch("/api/settings/audio", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(data)
            })
            .then(response => {
                console.log("Save response status:", response.status);
                if (!response.ok) {
                    throw new Error("HTTP " + response.status);
                }
                return response.text();
            })
            .then(() => {
                document.getElementById("status").textContent = "تم الحفظ";
                alert("تم حفظ إعدادات الصوت");
            })
            .catch(error => {
                console.error("Save error:", error);
                document.getElementById("status").textContent = "خطأ في الحفظ";
                alert("فشل حفظ الإعدادات");
            });

        }


        /* =========================================================
        Startup
        ========================================================= */

        window.addEventListener(
            "DOMContentLoaded",
            loadAudioSettings
        );

    </script>


    </body>

    </html>
