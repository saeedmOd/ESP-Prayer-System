    <!DOCTYPE html>
    <html lang="ar" dir="rtl">

    <head>

        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

        <title>إعدادات الصوت</title>

        <style>

            /* =========================================================
            Root
            ========================================================= */

            :root {

                --primary: #2563eb;
                --primary-hover: #1d4ed8;

                --bg: #f8fafc;
                --card-bg: #ffffff;

                --text: #0f172a;
                --muted: #64748b;

                --border: #e2e8f0;

                --radius: 18px;
                --radius-small: 12px;

                --shadow:
                    0 4px 20px -2px rgba(0, 0, 0, 0.06);

                --shadow-hover:
                    0 8px 28px -4px rgba(0, 0, 0, 0.10);

            }


            /* =========================================================
            Reset
            ========================================================= */

            * {

                box-sizing: border-box;

                -webkit-tap-highlight-color: transparent;

            }


            html {

                width: 100%;

                min-height: 100%;

                scroll-behavior: smooth;

            }


            body {

                margin: 0;

                padding: 18px;

                min-height: 100vh;

                font-family:
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    Roboto,
                    Tahoma,
                    Arial,
                    sans-serif;

                background:
                    linear-gradient(
                        145deg,
                        #f8fafc 0%,
                        #eef2f7 100%
                    );

                color: var(--text);

                direction: rtl;

                padding-bottom: 105px;

            }


            /* =========================================================
            Main App
            ========================================================= */

            .app {

                width: 100%;

                max-width: 1450px;

                margin: 0 auto;

            }


            /* =========================================================
            Header
            ========================================================= */

            .header {

                width: 100%;

                background:
                    linear-gradient(
                        135deg,
                        #1d4ed8,
                        #2563eb,
                        #3b82f6
                    );

                color: #ffffff;

                padding: 18px 22px;

                border-radius: 20px;

                box-shadow:
                    0 8px 28px rgba(37, 99, 235, 0.18);

                display: flex;

                justify-content: space-between;

                align-items: center;

                gap: 15px;

                margin-bottom: 18px;

            }


            .header h1 {

                margin: 0;

                font-size: 1.25rem;

                font-weight: 700;

            }


            .header small {

                display: block;

                margin-top: 4px;

                opacity: 0.85;

                font-size: 0.8rem;

            }


            .status-badge {

                flex-shrink: 0;

                font-size: 0.8rem;

                padding: 6px 12px;

                background:
                    rgba(255, 255, 255, 0.18);

                color: #ffffff;

                border-radius: 30px;

                font-weight: 600;

                white-space: nowrap;

            }


            /* =========================================================
            Three Columns
            ========================================================= */

            .settings-grid {

                display: grid;

                grid-template-columns:
                    repeat(3, minmax(0, 1fr));

                gap: 18px;

                align-items: start;

            }


            .settings-column {

                display: flex;

                flex-direction: column;

                gap: 18px;

                min-width: 0;

            }


            /* =========================================================
            Cards
            ========================================================= */

            .card {

                width: 100%;

                background: var(--card-bg);

                border-radius: var(--radius);

                padding: 20px;

                border: 1px solid var(--border);

                box-shadow: var(--shadow);

                display: flex;

                flex-direction: column;

                gap: 15px;

                min-width: 0;

                transition:
                    box-shadow 0.2s ease,
                    transform 0.2s ease;

            }


            .card:hover {

                box-shadow: var(--shadow-hover);

            }


            .card-header {

                display: flex;

                justify-content: space-between;

                align-items: center;

                gap: 10px;

                padding-bottom: 12px;

                border-bottom: 1px solid var(--border);

            }


            .card-header h2 {

                margin: 0;

                font-size: 1.05rem;

                font-weight: 700;

                display: flex;

                align-items: center;

                gap: 7px;

            }


            .card-header h3 {

                margin: 0;

                font-size: 0.95rem;

                font-weight: 700;

            }


            /* =========================================================
            Fields
            ========================================================= */

            .field-group {

                display: flex;

                flex-direction: column;

                gap: 6px;

            }


            label,
            .label {

                font-size: 0.84rem;

                font-weight: 600;

                color: var(--muted);

            }


            .field-row {

                display: grid;

                grid-template-columns:
                    repeat(2, minmax(0, 1fr));

                gap: 10px;

            }


            /* =========================================================
            Inputs
            ========================================================= */

            input[type="number"],
            select {

                width: 100%;

                min-width: 0;

                min-height: 44px;

                padding: 10px 12px;

                border:
                    1px solid var(--border);

                border-radius: var(--radius-small);

                background: #f8fafc;

                color: var(--text);

                font-family: inherit;

                font-size: 0.92rem;

                outline: none;

                transition:
                    border-color 0.2s ease,
                    box-shadow 0.2s ease,
                    background 0.2s ease;

            }


            input[type="number"]:focus,
            select:focus {

                border-color: var(--primary);

                background: #ffffff;

                box-shadow:
                    0 0 0 3px rgba(37, 99, 235, 0.10);

            }


            /* =========================================================
            Compact Select
            ========================================================= */

            .compact-select {

                width: auto;

                min-width: 82px;

                min-height: 38px;

                padding: 6px 9px;

                font-size: 0.78rem;

            }


            /* =========================================================
            Volume
            ========================================================= */

            .volume-box {

                width: 100%;

                min-height: 48px;

                background: #f1f5f9;

                padding: 10px 13px;

                border-radius: 14px;

                display: flex;

                align-items: center;

                gap: 10px;

            }


            input[type="range"] {

                flex: 1;

                min-width: 0;

                height: 5px;

                padding: 0;

                accent-color: var(--primary);

                cursor: pointer;

            }


            .val-badge {

                min-width: 30px;

                text-align: center;

                font-weight: 700;

                color: var(--primary);

                font-size: 0.85rem;

            }


            .small-volume-box {

                display: flex;

                align-items: center;

                gap: 8px;

                background: #f1f5f9;

                border-radius: 12px;

                padding: 9px 11px;

            }


            .small-volume-box input[type="range"] {

                flex: 1;

            }


            .volume-icon {

                flex-shrink: 0;

                font-size: 14px;

            }


            .small-volume-value {

                min-width: 28px;

                text-align: center;

                font-size: 0.8rem;

                font-weight: 700;

                color: var(--primary);

            }


            /* =========================================================
            Test Button
            ========================================================= */

            .btn-test {

                width: 100%;

                min-height: 46px;

                padding: 10px 12px;

                background: #eff6ff;

                color: var(--primary);

                border:
                    1px solid #bfdbfe;

                border-radius: 12px;

                font-family: inherit;

                font-size: 0.88rem;

                font-weight: 600;

                cursor: pointer;

                display: flex;

                align-items: center;

                justify-content: center;

                gap: 6px;

                transition:
                    background 0.2s ease,
                    transform 0.15s ease;

            }


            .btn-test:hover {

                background: #dbeafe;

            }


            .btn-test:active {

                transform: scale(0.98);

            }


            /* =========================================================
            Iqama Prayer Grid
            ========================================================= */

            .prayer-check-grid {

                display: grid;

                grid-template-columns:
                    repeat(3, minmax(0, 1fr));

                gap: 7px;

            }


            .prayer-check {

                margin: 0;

                padding: 9px 5px;

                min-width: 0;

                display: flex;

                align-items: center;

                justify-content: center;

                gap: 5px;

                background: #f8fafc;

                border:
                    1px solid var(--border);

                border-radius: 10px;

                color: var(--muted);

                font-size: 0.76rem;

                cursor: pointer;

                transition:
                    background 0.2s ease,
                    border-color 0.2s ease,
                    color 0.2s ease;

            }


            .prayer-check input {

                width: 15px;

                height: 15px;

                min-height: 15px;

                margin: 0;

                padding: 0;

                accent-color: var(--primary);

                cursor: pointer;

            }


            .prayer-check:has(input:checked) {

                background: #eff6ff;

                border-color: #93c5fd;

                color: var(--primary);

            }


            /* =========================================================
            Adhkar
            ========================================================= */

            .adhkar-grid {

                display: grid;

                grid-template-columns:
                    repeat(2, minmax(0, 1fr));

                gap: 12px;

            }


            .adhkar-card {

                min-width: 0;

                background: #f8fafc;

                border:
                    1px solid var(--border);

                border-radius: 14px;

                padding: 13px;

                display: flex;

                flex-direction: column;

                gap: 12px;

            }


            .adhkar-header {

                display: flex;

                justify-content: space-between;

                align-items: center;

                gap: 7px;

            }


            .adhkar-header h3 {

                margin: 0;

                font-size: 0.9rem;

                white-space: nowrap;

                overflow: hidden;

                text-overflow: ellipsis;

            }


            .adhkar-header select {

                width: auto;

                min-width: 65px;

                min-height: 36px;

                padding: 5px;

                font-size: 0.75rem;

            }


            /* =========================================================
            Folder / File
            ========================================================= */

            .system-row {

                display: flex;

                align-items: center;

                justify-content: space-between;

                gap: 10px;

                padding: 11px 13px;

                background: #f8fafc;

                border:
                    1px solid var(--border);

                border-radius: 12px;

            }


            .system-row span {

                white-space: nowrap;

                color: var(--muted);

                font-size: 0.85rem;

                font-weight: 600;

            }


            .system-row input {

                width: 90px;

                min-height: 40px;

            }


            .folder-test {

                display: flex;

                flex-direction: column;

                gap: 10px;

            }


            /* =========================================================
            Floating Footer
            ========================================================= */

            .actions-footer {

                position: fixed;

                left: 0;

                right: 0;

                bottom: 0;

                z-index: 100;

                background:
                    rgba(255, 255, 255, 0.88);

                backdrop-filter: blur(14px);

                -webkit-backdrop-filter: blur(14px);

                padding:
                    12px 18px;

                border-top:
                    1px solid var(--border);

            }


            .actions-container {

                width: 100%;

                max-width: 1450px;

                margin: 0 auto;

                display: grid;

                grid-template-columns:
                    2fr 1fr;

                gap: 10px;

            }


            .btn-primary,
            .btn-secondary {

                min-height: 50px;

                border-radius: 13px;

                font-family: inherit;

                font-size: 0.95rem;

                cursor: pointer;

                font-weight: 700;

            }


            .btn-primary {

                background: var(--primary);

                color: #ffffff;

                border: none;

                box-shadow:
                    0 5px 15px rgba(37, 99, 235, 0.20);

            }


            .btn-primary:hover {

                background: var(--primary-hover);

            }


            .btn-secondary {

                background: #f1f5f9;

                color: var(--muted);

                border:
                    1px solid var(--border);

            }


            .btn-primary:active,
            .btn-secondary:active {

                transform: scale(0.98);

            }


            /* =========================================================
            Tablet
            ========================================================= */

            @media (max-width: 1050px) {

                .settings-grid {

                    grid-template-columns:
                        repeat(2, minmax(0, 1fr));

                }

            }


            /* =========================================================
            Mobile
            ========================================================= */

            @media (max-width: 700px) {

                body {

                    padding: 10px;

                    padding-bottom: 95px;

                }


                .header {

                    padding: 15px;

                    margin-bottom: 12px;

                }


                .settings-grid {

                    grid-template-columns: 1fr;

                    gap: 12px;

                }


                .settings-column {

                    gap: 12px;

                }


                .card {

                    padding: 15px;

                    border-radius: 16px;

                }


                .adhkar-grid {

                    grid-template-columns:
                        repeat(2, minmax(0, 1fr));

                    gap: 8px;

                }


                .prayer-check-grid {

                    grid-template-columns:
                        repeat(2, minmax(0, 1fr));

                }


                .actions-footer {

                    padding:
                        9px 10px;

                }


                .actions-container {

                    grid-template-columns:
                        2fr 1fr;

                }

            }


            /* =========================================================
            Very Small Screens
            ========================================================= */

            @media (max-width: 360px) {

                body {

                    padding: 7px;

                    padding-bottom: 90px;

                }


                .header {

                    flex-direction: column;

                    text-align: center;

                    gap: 8px;

                }


                .card {

                    padding: 12px;

                }


                .field-row {

                    gap: 7px;

                }


                .adhkar-grid {

                    gap: 6px;

                }


                .adhkar-card {

                    padding: 9px;

                }


                .adhkar-header h3 {

                    font-size: 0.78rem;

                }


                .adhkar-header select {

                    min-width: 58px;

                    font-size: 0.7rem;

                }


                .prayer-check {

                    font-size: 0.7rem;

                    padding: 8px 3px;

                }


                .actions-container {

                    gap: 7px;

                }


                .btn-primary,
                .btn-secondary {

                    min-height: 46px;

                    font-size: 0.85rem;

                }

            }


            /* =========================================================
            Reduced Motion
            ========================================================= */

            @media (prefers-reduced-motion: reduce) {

                * {

                    transition: none !important;

                    scroll-behavior: auto !important;

                }

            }

        </style>

    </head>


    <body>


    <div class="app">


        <!-- =====================================================
            Header
            ===================================================== -->

        <header class="header">

            <div>

                <h1>🔊 إعدادات الصوت</h1>

                <small>
                    التحكم في جميع أصوات النظام
                </small>

            </div>


            <span
                id="status"
                class="status-badge">

                جاري التحميل...

            </span>

        </header>


        <!-- =====================================================
            THREE COLUMNS
            ===================================================== -->

        <main class="settings-grid">


            <!-- =================================================
                COLUMN 1
                ================================================= -->

            <div class="settings-column">


                <!-- =============================================
                    التحكم العام
                    ============================================= -->

                <section class="card">

                    <div class="card-header">

                        <h2>
                            🎛️ التحكم العام
                        </h2>

                    </div>


                    <div class="field-group">

                        <label>
                            مستوى الصوت العام
                        </label>


                        <div class="volume-box">

                            <span>🔈</span>


                            <input
                                type="range"
                                id="volume"
                                min="0"
                                max="30"
                                value="15"
                                oninput="showVolume(this.value)">


                            <span
                                id="volumeValue"
                                class="val-badge">

                                15

                            </span>


                            <span>🔊</span>

                        </div>

                    </div>

                </section>


                <!-- =============================================
                    الأذان
                    ============================================= -->

                <section class="card">

                    <div class="card-header">

                        <h2>
                            🕌 الأذان
                        </h2>


                        <select
                            id="azanEnable"
                            class="compact-select">

                            <option value="true">
                                مفعل
                            </option>

                            <option value="false">
                                معطل
                            </option>

                        </select>

                    </div>


                    <div class="field-group">

                        <label>
                            صوت الأذان
                        </label>


                        <select
                            id="azanPreset"
                            onchange="applyPreset('azan')">

                            <option value="1:1">
                                أذان مؤسسة دبي للإعلام
                            </option>

                            <option value="1:2">
                                أذان قصير
                            </option>

                            <option value="1:3">
                                أذان الحرم المكي
                            </option>

                            <option value="1:4">
                                أذان الشيخ مشاري
                            </option>

                            <option value="1:5">
                                جرس
                            </option>

                        </select>

                    </div>






                    <button
                        class="btn-test"
                        onclick="testAzan()">

                        ▶️ تجربة الأذان

                    </button>

                </section>


                <!-- =============================================
                    الإقامة
                    ============================================= -->

                <section class="card">

                    <div class="card-header">

                        <h2>
                            ⏱️ الإقامة
                        </h2>


                        <select
                            id="iqamaEnable"
                            class="compact-select">

                            <option value="true">
                                مفعل
                            </option>

                            <option value="false">
                                معطل
                            </option>

                        </select>

                    </div>


                    <div class="field-group">

                        <label>
                            🔊 صوت الإقامة
                        </label>


                        <select
                            id="iqamaPreset"
                            onchange="applyIqamaPreset()">

                            <option value="2:1">
                                إقامة الحرم المكي
                            </option>

                            <option value="2:2">
                                إقامة الحرم المدني
                            </option>

                            <option value="2:3">
                                إقامة قصيرة
                            </option>

                            <option value="2:4">
                                إقامة طويلة
                            </option>

                            <option value="2:5">
                                جرس
                            </option>

                        </select>

                    </div>


                    <div class="field-group">

                        <label>
                            🔉 مستوى صوت الإقامة
                        </label>


                        <div class="small-volume-box">

                            <span class="volume-icon">
                                🔊
                            </span>


                            <input
                                type="range"
                                id="iqamaVolume"
                                min="0"
                                max="30"
                                value="12"
                                oninput="
                                    showValue(
                                        'iqamaVolumeValue',
                                        this.value
                                    );
                                ">


                            <span
                                id="iqamaVolumeValue"
                                class="small-volume-value">

                                12

                            </span>

                        </div>

                    </div>


                    <div class="field-group">

                        <label>
                            🕌 الصلوات التي يتم تشغيل الإقامة لها
                        </label>


                        <div class="prayer-check-grid">


                            <label class="prayer-check">

                                <input
                                    type="checkbox"
                                    id="iqamaFajr">

                                <span>
                                    الفجر
                                </span>

                            </label>


                            <label class="prayer-check">

                                <input
                                    type="checkbox"
                                    id="iqamaDhuhr">

                                <span>
                                    الظهر
                                </span>

                            </label>


                            <label class="prayer-check">

                                <input
                                    type="checkbox"
                                    id="iqamaAsr">

                                <span>
                                    العصر
                                </span>

                            </label>


                            <label class="prayer-check">

                                <input
                                    type="checkbox"
                                    id="iqamaMaghrib">

                                <span>
                                    المغرب
                                </span>

                            </label>


                            <label class="prayer-check">

                                <input
                                    type="checkbox"
                                    id="iqamaIsha">

                                <span>
                                    العشاء
                                </span>

                            </label>

                        </div>

                    </div>


                    <div class="field-group">

                        <label>
                            ⏳ تأخير الإقامة بعد الأذان
                        </label>


                        <div class="field-row">

                            <input
                                type="number"
                                id="iqamaDelay"
                                min="0"
                                max="60"
                                value="10">





                        </div>

                    </div>


                    <button
                        class="btn-test"
                        onclick="testIqama()">

                        ▶️ تجربة الإقامة

                    </button>

                </section>


            </div>


            <!-- =================================================
                COLUMN 2
                ================================================= -->

            <div class="settings-column">


<!-- =============================================
     أذكار الصباح والمساء
     ============================================= -->

<section class="card">

    <div class="card-header">

        <h2>
            📿 أذكار الصباح والمساء
        </h2>

    </div>


    <div class="adhkar-grid">


        <!-- =====================================
             Morning Adhkar
             Folder: 4
             File: 1
             ===================================== -->

        <div
            class="adhkar-card"
            data-folder="4"
            data-file="1"
            data-type="morningAdhkar">


            <div class="adhkar-header">

                <h3>
                    🌅 الصباح
                </h3>


                <select
                    id="morningAdhkarEnable"
                    class="compact-select">

                    <option value="true">
                        مفعل
                    </option>

                    <option value="false">
                        معطل
                    </option>

                </select>

            </div>


            <!-- Audio File Info -->

            <div class="system-row">

                <span>
                    🎵 الملف
                </span>

                <span>
                    مجلد 4 / ملف 1
                </span>

            </div>


            <!-- Time -->

            <div class="field-group">

                <label>
                    وقت التشغيل
                </label>


                <div class="field-row">

                    <input
                        type="number"
                        id="morningAdhkarHour"
                        min="0"
                        max="23"
                        value="6"
                        placeholder="ساعة">


                    <input
                        type="number"
                        id="morningAdhkarMinute"
                        min="0"
                        max="59"
                        value="0"
                        placeholder="دقيقة">

                </div>

            </div>


            <!-- Volume -->

            <div class="field-group">

                <label>
                    🔊 مستوى الصوت
                </label>


                <div class="volume-box">

                    <input
                        type="range"
                        id="morningAdhkarVolume"
                        min="0"
                        max="30"
                        value="9"
                        oninput="
                            showValue(
                                'morningAdhkarVolumeValue',
                                this.value
                            );
                        ">


                    <span
                        id="morningAdhkarVolumeValue"
                        class="val-badge">

                        9

                    </span>

                </div>

            </div>


            <!-- Test -->

            <button
                type="button"
                class="btn-test"
                onclick="testMorningAdhkar()">

                ▶️ تجربة أذكار الصباح

            </button>

        </div>


        <!-- =====================================
             Evening Adhkar
             Folder: 4
             File: 2
             ===================================== -->

        <div
            class="adhkar-card"
            data-folder="4"
            data-file="2"
            data-type="eveningAdhkar">


            <div class="adhkar-header">

                <h3>
                    🌙 المساء
                </h3>


                <select
                    id="eveningAdhkarEnable"
                    class="compact-select">

                    <option value="true">
                        مفعل
                    </option>

                    <option value="false">
                        معطل
                    </option>

                </select>

            </div>


            <!-- Audio File Info -->

            <div class="system-row">

                <span>
                    🎵 الملف
                </span>

                <span>
                    مجلد 4 / ملف 2
                </span>

            </div>


            <!-- Time -->

            <div class="field-group">

                <label>
                    وقت التشغيل
                </label>


                <div class="field-row">

                    <input
                        type="number"
